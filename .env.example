# Anthropic (or Anthropic-compatible proxy)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model choice — vision-capable model recommended for click-by-name to work.
VOXIE_MODEL=claude-sonnet-4-5

# Whisper model: tiny.en / base.en / small.en. Bigger = more accurate + slower.
VOXIE_WHISPER_MODEL=base.en

# Global hotkey to toggle listening. pynput format: modifiers in <angle> + key.
VOXIE_HOTKEY=<ctrl>+<alt>+<space>

# Input device to record from. Leave blank for OS default.
# Accepts either a device INDEX from the startup log (e.g. 18) or a
# substring of the device name (e.g. GPods, Headset, Realtek).
VOXIE_INPUT_DEVICE=
