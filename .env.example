# Anthropic (or Anthropic-compatible proxy)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model choice — vision-capable model recommended for click-by-name to work.
VOXIE_MODEL=claude-sonnet-4-5

# Whisper model: tiny.en / base.en / small.en. Bigger = more accurate + slower.
VOXIE_WHISPER_MODEL=base.en

# Global hotkey to toggle listening. pynput format: modifiers in <angle> + key.
VOXIE_HOTKEY=<ctrl>+<alt>+<space>

# Input device to record from. Leave blank for OS default.
# Accepts either a device INDEX from the startup log (e.g. 18) or a
# substring of the device name (e.g. GPods, Headset, Realtek).
VOXIE_INPUT_DEVICE=

# Text-to-speech: voxie speaks its replies. on/off.
VOXIE_TTS=on

# Speaking rate in words-per-minute (pyttsx3 default is ~200). Blank = default.
VOXIE_VOICE_RATE=

# Hotkey for DICTATION mode: transcribe speech and type it at the cursor,
# with no LLM in the loop. Toggle to start, toggle again to type.
VOXIE_DICTATE_HOTKEY=<ctrl>+<alt>+d

# Wake word: always-listening "hey voxie" instead of pressing a hotkey.
# Costs some CPU while you are talking (it transcribes short bursts locally);
# idles near zero in silence. on/off.
VOXIE_WAKE=off
VOXIE_WAKE_PHRASE=voxie
VOXIE_WAKE_MODEL=base.en
# Extra spellings to accept, comma separated. Whisper writes invented words
# however they sounded, so if the log shows it hearing a spelling that is not
# recognised, add it here.
VOXIE_WAKE_ALIASES=

# Send automatically when you stop talking, instead of pressing the hotkey
# again. The hotkey still works as a manual override. on/off.
VOXIE_AUTO_SEND=on

# How long a pause counts as "done talking", in seconds. Raise it if you get
# cut off mid-thought; lower it for snappier turnaround.
VOXIE_SILENCE_HOLD=1.3
